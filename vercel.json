{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "/server/app.js"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "/client/robots.txt"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/client/sitemap.xml"
    },
    {
      "src": "^/(assets/.*)",
      "dest": "/client/$1"
    },
    {
      "src": "^/icon\\.png$",
      "dest": "/client/icon.png"
    },
    {
      "src": ".*",
      "dest": "/client/index.html"
    }
  ]
}
